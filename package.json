{
  "name": "agent-wrapped",
  "version": "0.1.0",
  "description": "Your Claude Code month in review, as a shareable PNG or SVG. Runs entirely on your machine.",
  "type": "module",
  "bin": {
    "agent-wrapped": "./dist/cli.js"
  },
  "files": [
    "dist",
    "assets"
  ],
  "keywords": [
    "claude",
    "claude-code",
    "wrapped",
    "stats",
    "cli",
    "usage"
  ],
  "author": "nitrimandylis",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nitrimandylis/agent-wrapped.git"
  },
  "homepage": "https://github.com/nitrimandylis/agent-wrapped#readme",
  "bugs": "https://github.com/nitrimandylis/agent-wrapped/issues",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "bun src/cli.ts",
    "check": "bun src/check.ts",
    "typecheck": "tsc --noEmit",
    "build": "bun build src/cli.ts --outfile dist/cli.js --target node --format esm --external @resvg/resvg-js --external ccusage",
    "prepack": "bun run build",
    "skill": "[ -d ~/.claude/skills ] && cp -R agent-wrapped-cli ~/.claude/skills/ || true"
  },
  "dependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "ccusage": "^20.0.0",
    "satori": "^0.26.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  }
}
